// ================================================================
//  api.x.lan.open/sli.ready
//  Minimaler Ready-Status: Zeit · Ort · Home
// ================================================================

export function sliReady() {
  return {
    time: Date.now(),          // Zeitstempel
    ort: location.hash || '',  // aktueller Stage-Ort
    home: 'ROOT',              // Grundzustand
  };
}

