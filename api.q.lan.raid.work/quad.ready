// ================================================================
//  api.q.lan.raid.work/quad.ready
//  Minimaler Quad-Ready-Status: Zeit · Ort · Home · Quad
// ================================================================

export function quadReady() {
  return {
    time: Date.now(),          // Zeitstempel
    ort: location.hash || '',  // aktueller Stage-Ort
    home: 'ROOT',              // Grundzustand
    quad: true                 // Quad-Ready-Signal
  };
}
